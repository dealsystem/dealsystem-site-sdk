{
	"name": "@dealsystem/site",
	"version": "0.1.0",
	"description": "Komponenten, Lade-Helfer und Vite-Plugin für Self-Service-Websites auf DealSystem",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"contract",
		"!dist/**/*.test.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"build": "svelte-package --input src/lib --output dist && publint"
	},
	"peerDependencies": {
		"svelte": "^5.46.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.12",
		"jsdom": "^31.0.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	}
}
