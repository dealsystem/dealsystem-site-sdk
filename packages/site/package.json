{
	"name": "@dealsystem/site",
	"version": "0.1.0",
	"description": "Komponenten, Lade-Helfer und Vite-Plugin für Self-Service-Websites auf DealSystem",
	"license": "MIT",
	"keywords": [
		"dealsystem",
		"svelte",
		"sveltekit",
		"website"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"contract",
		"docs",
		"!dist/**/*.test.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./content": {
			"types": "./dist/content/index.d.ts",
			"default": "./dist/content/index.js"
		},
		"./config": {
			"types": "./dist/config/index.d.ts",
			"default": "./dist/config/index.js"
		},
		"./vite": {
			"types": "./dist/vite/index.d.ts",
			"default": "./dist/vite/index.js"
		},
		"./docs/*": "./docs/*",
		"./contract/site-api.v1.json": "./contract/site-api.v1.json",
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tests/types/tsconfig.json",
		"test": "vitest run",
		"build": "svelte-package --input src/lib --output dist && publint"
	},
	"dependencies": {
		"@friendlycaptcha/sdk": "^1.1.5",
		"esm-env": "^1.2.2",
		"marked": "^18.2.1",
		"sanitize-html": "^2.18.2"
	},
	"peerDependencies": {
		"svelte": "^5.46.0",
		"vite": "^7.0.0 || ^8.0.0"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.12",
		"@types/node": "^22.20.5",
		"@types/sanitize-html": "^2.16.2",
		"ajv": "^8.20.0",
		"jsdom": "^31.0.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	}
}
