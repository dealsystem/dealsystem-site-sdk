{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"types": ["vitest/globals", "@testing-library/jest-dom", "@sveltejs/kit"]
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts", "tests/**/*.svelte", "*.ts", "*.js"],
	"exclude": ["dist", "node_modules", "tests/types", "tests/types-invalid", "tests/fixtures/project"]
}
