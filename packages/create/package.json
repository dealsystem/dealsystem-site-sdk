{
	"name": "create-dealsystem-site",
	"version": "0.2.0",
	"publishConfig": {
		"access": "public"
	},
	"description": "Starter für Self-Service-Websites auf DealSystem: npm create dealsystem-site",
	"license": "MIT",
	"author": "DealSystem (https://dealsystem.io)",
	"homepage": "https://github.com/dealsystem/dealsystem-site-sdk/tree/main/packages/create#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dealsystem/dealsystem-site-sdk.git",
		"directory": "packages/create"
	},
	"bugs": {
		"url": "https://github.com/dealsystem/dealsystem-site-sdk/issues"
	},
	"type": "module",
	"bin": {
		"create-dealsystem-site": "./bin/create.js"
	},
	"exports": {
		".": "./bin/scaffold.js",
		"./package.json": "./package.json"
	},
	"files": [
		"bin",
		"template"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"pretest": "node ../cli/scripts/ensure-site.mjs && npm run build -w dealsystem --if-present",
		"test": "vitest run",
		"check": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@dealsystem/site": "^0.2.0",
		"@fontsource-variable/inter": "^5.2.8",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^22.20.5",
		"dealsystem": "^0.2.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	}
}
